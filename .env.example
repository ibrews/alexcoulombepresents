# ── Store / payments (all optional until the store goes live) ──────────────
# Stripe secret key — sk_test_... while testing, sk_live_... in production.
STRIPE_SECRET_KEY=

# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
# (endpoint: /api/stripe-webhook, event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Canonical site URL used for checkout redirect URLs.
NEXT_PUBLIC_SITE_URL=https://alexcoulombepresents.com

# Flip to "1" to enable real checkout buttons (otherwise the store is in
# preview mode and buttons fall back to mailto).
NEXT_PUBLIC_STORE_LIVE=
