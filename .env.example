# ── Store / payments (all optional until the store goes live) ──────────────
# Stripe secret key — sk_test_... while testing, sk_live_... in production.
STRIPE_SECRET_KEY=

# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
# (endpoint: /api/stripe-webhook; events: checkout.session.completed,
# charge.refunded, customer.subscription.created/updated/deleted, invoice.paid)
STRIPE_WEBHOOK_SECRET=

# Membership subscription price (price_...) — create in Stripe Dashboard →
# Product catalog (recurring, monthly). Until set, the membership webhook
# branches ignore every subscription event. See lib/commerce/membershipBilling.ts.
STRIPE_MEMBERSHIP_PRICE_ID=

# Canonical site URL used for checkout redirect URLs.
NEXT_PUBLIC_SITE_URL=https://alexcoulombepresents.com

# Flip to "1" to enable real checkout buttons (otherwise the store is in
# preview mode and buttons fall back to mailto).
NEXT_PUBLIC_STORE_LIVE=

# ── Zoom auto-invite (lib/zoom.ts) ──────────────────────────────────────────
# Server-to-Server OAuth app credentials — the same "ZoomClaude" app used by
# the KB's meeting-digest pipeline (marketplace.zoom.us/develop/apps), scoped
# up 2026-08-12 with meeting:write:meeting:admin +
# meeting:write:registrant:admin. Until all three are set, class-purchase and
# office-hours auto-registration silently no-op (buyers still get the
# self-serve registration link/manual Zoom email, same as before this
# feature existed).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Digital-license commerce core (Phase 1) ─────────────────────────────────
# Flip to "1" once Stripe + R2 + email are wired end-to-end (checkout ->
# webhook -> license key -> download). See lib/commerce/products.ts.
NEXT_PUBLIC_DIGITAL_STORE_LIVE=

# Ed25519 keypair for offline-verifiable license keys. Generate once with
# `npx tsx scripts/generate-license-keypair.ts`. Private key is server-only
# and secret; public key is not secret (also ships inside sold zips).
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# Any long random string — salts magic-link/session token hashes.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Shared password for the private Isle advisor portal. Keep this empty locally
# unless you need to test the gate; set the real value in the Vercel project.
ISLE_PORTAL_PASSWORD=

# Cloudflare R2 (S3-compatible object storage for licensed downloads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# DATABASE_URL (Neon Postgres) and RESEND_API_KEY are already provisioned —
# see the existing Vercel project env / departments/engineering/api-keys.md.

# ── UE plugin licensing (URMBridge, SceneAudit, Forage, BPAutoLayout,
# URKPreviewer) ──────────────────────────────────────────────────────────────
# Shared HMAC-SHA256 secret used to sign + verify offline plugin license
# files (format + verifier: lib/commerce/pluginLicensing.ts). Any long random
# string — generate with: openssl rand -base64 32
# Until this is set, POST /api/plugins/entitlement fails closed (500) rather
# than treating every submitted license as valid.
ACP_PLUGIN_LICENSE_SECRET=

# ── /book — request-then-confirm appointments (lib/booking) ────────────────
# The SECRET iCal addresses of every calendar that should count as "busy",
# comma- or newline-separated. Zoom Scheduler pools several calendars to decide
# availability and this does the same: a slot that's free on one account is
# worthless if another is booked.
#
# Per calendar: Google Calendar → Settings for my calendars → <calendar> →
# "Secret address in iCal format". Treat each as a credential — anyone holding
# one can read that calendar. ALL listed feeds must load; if any fails, /book
# reports the calendar as unreadable rather than offering time a missing feed
# might already own.
#
# Without any of them, /book refuses to offer times at all (rather than
# guessing). That is deliberate — see fetchBusyIntervals in lib/booking/config.ts.
BOOKING_ICS_URLS=
# Single-feed spelling, still supported.
BOOKING_ICS_URL=
#
# Escape hatch to run /book with NO calendar feed: offers the configured
# weekly windows minus slots already claimed in our own database. Only safe
# because nothing books or charges without a manual confirmation first, which
# is where a real conflict gets caught. Leave unset once BOOKING_ICS_URL works.
BOOKING_ALLOW_NO_CALENDAR=
